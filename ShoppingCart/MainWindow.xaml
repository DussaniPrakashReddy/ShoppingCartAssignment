
    <Window x:Class="ShoppingCart.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:converters="clr-namespace:ShoppingCart.WPF.Converters"
        xmlns:controls="clr-namespace:ShoppingCart.WPF.Controls"
            xmlns:views="clr-namespace:ShoppingCart.WPF.Views"
        Title="Shopping Cart"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <!-- ========================================================= -->
        <!-- ROOT LAYOUT                                               -->
        <!-- ========================================================= -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- LEFT SIDEBAR                                              -->
        <!-- ========================================================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>


                <!-- BRAND -->

                <StackPanel Grid.Row="0"
                            Margin="24,20">

                    <TextBlock Text="SHOPPING"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold" />

                    <TextBlock Text="CART"
                               Foreground="#6EA8FE"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />

                </StackPanel>


                <!-- NAVIGATION -->

                <StackPanel Grid.Row="1"
                            Margin="12,20">

                    <!-- Active -->

                    <Button Content="⌂   Point of Sale"
                            Command="{Binding NavigateToPosCommand}"
                            Style="{StaticResource ActiveNavigationButtonStyle}" />

                    <Button Content="Products"
        Command="{Binding OpenProductsCommand}"
        Style="{StaticResource NavigationButtonStyle}" />

                   
                </StackPanel>


                <!-- SIDEBAR FOOTER -->

                <TextBlock Grid.Row="2"
                           Text="ShoppingCart • v1.0"
                           Foreground="#66758D"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN APPLICATION AREA                                     -->
        <!-- ========================================================= -->

        <Grid Grid.Column="1"
              Margin="28">

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="70" />

                <!-- Customer -->
                <RowDefinition Height="Auto" />

                <!-- Products + Cart -->
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- HEADER                                                 -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Point of Sale"
                               Style="{StaticResource PageTitleStyle}" />

                    <TextBlock Text="Create and manage customer orders"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />

                </StackPanel>


                <!-- HEADER RIGHT -->

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">


                    <!-- ONLINE STATUS -->

                    <Border Style="{StaticResource StatusCardStyle}"
                            Margin="0,0,15,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />

                            <TextBlock Text="ONLINE"
                                       Foreground="#16834D"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                    </Border>


                    <!-- ORDER NUMBER -->

                    <Border Style="{StaticResource OrderBadgeStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Order #"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{Binding OrderId, Mode=OneWay}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />

                            <Button Content="+ NEW ORDER"
                                    Command="{Binding NewOrderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Padding="18,0"
                                    Margin="12,0,0,0" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ===================================================== -->
            <!-- CUSTOMER SECTION                                       -->
            <!-- ===================================================== -->

            <views:CustomerView
    Grid.Row="1"
    DataContext="{Binding CustomerViewModel}"
    Margin="0,0,0,22"/>


            <!-- ===================================================== -->
            <!-- PRODUCTS + CART WORKSPACE                              -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <!-- Products -->
                    <ColumnDefinition Width="*" />

                    <!-- Cart -->
                    <ColumnDefinition Width="390" />

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- PRODUCTS                                           -->
                <!-- ================================================= -->

                <views:ProductsView
    Grid.Column="0"
    DataContext="{Binding ProductsViewModel}"
    AddToCartCommand="{Binding DataContext.AddToCartCommand,
                               RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
    Margin="0,0,24,0"/>


                <!-- ================================================= -->
                <!-- CART                                               -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>

                            <!-- Header -->
                            <RowDefinition Height="55" />

                            <!-- Items -->
                            <RowDefinition Height="*" />

                            <!-- Summary -->
                            <RowDefinition Height="170" />

                        </Grid.RowDefinitions>


                        <!-- CART HEADER -->

                        <Grid Grid.Row="0">

                            <StackPanel>

                                <TextBlock Text="Current Cart"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Text="{Binding CartItems.Count,
                                                         StringFormat='{}{0} items'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />

                            </StackPanel>


                            <Button Content="CLEAR"
                                    Command="{Binding ClearCartCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DangerButtonStyle}" />

                        </Grid>


                        <!-- ================================================= -->
                        <!-- CART ITEMS                                        -->
                        <!-- ================================================= -->

                        <Grid Grid.Row="1">

                            <!-- EMPTY CART -->

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <StackPanel.Style>

                                    <Style TargetType="StackPanel">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding HasItems}"
                                                         Value="False">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </StackPanel.Style>


                                <TextBlock Text="🛒"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           Opacity="0.35" />

                                <TextBlock Text="Your cart is empty"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />

                                <TextBlock Text="Add products to start an order"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />

                            </StackPanel>


                            <!-- CART ITEMS LIST -->

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <ScrollViewer.Style>

                                    <Style TargetType="ScrollViewer">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding HasItems}"
                                                         Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ScrollViewer.Style>


                                <ItemsControl ItemsSource="{Binding CartItems}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,14">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*" />

                                                        <ColumnDefinition Width="110" />

                                                        <ColumnDefinition Width="70" />

                                                    </Grid.ColumnDefinitions>


                                                    <!-- ITEM INFORMATION -->

                                                    <StackPanel>

                                                        <TextBlock Text="{Binding Fruit.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                                        <TextBlock Text="{Binding Fruit.Price,
                                                                                   StringFormat='{}{0:₹#,##0.00}'}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,2,0,0" />

                                                    </StackPanel>


                                                    <!-- QUANTITY -->

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">

                                                        <Button Content="−"
                                                                Command="{Binding DataContext.DecreaseQuantityCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Fruit}"
                                                                Style="{StaticResource QuantityButtonStyle}" />

                                                        <TextBlock Text="{Binding Quantity}"
                                                                   Width="28"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold" />

                                                        <Button Content="+"
                                                                Command="{Binding DataContext.IncreaseQuantityCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Fruit}"
                                                                Style="{StaticResource QuantityButtonStyle}" />

                                                    </StackPanel>


                                                    <!-- LINE TOTAL -->

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding LineTotal,
                                                                  StringFormat='{}{0:₹#,##0.00}'}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- CART SUMMARY                                     -->
                        <!-- ================================================= -->

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,15,0,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="30" />

                                    <RowDefinition Height="50" />

                                    <RowDefinition Height="55" />

                                </Grid.RowDefinitions>


                                <!-- SUBTOTAL -->

                                <Grid Grid.Row="0">

                                    <TextBlock Text="Subtotal"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />

                                    <TextBlock Text="{Binding Total,
                                                               StringFormat='{}{0:₹#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />

                                </Grid>


                                <!-- TOTAL -->

                                <Grid Grid.Row="1">

                                    <TextBlock Text="TOTAL"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding Total,
                                                               StringFormat='{}{0:₹#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" />

                                </Grid>


                                <!-- CHECKOUT -->

                                <Button Grid.Row="2"
                                        Content="CHECKOUT"
                                        Command="{Binding CheckoutCommand}"
                                        Style="{StaticResource SuccessButtonStyle}" />

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>