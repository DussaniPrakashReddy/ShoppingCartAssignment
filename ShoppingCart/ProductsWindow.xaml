<Window x:Class="ShoppingCart.WPF.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ShoppingCart.WPF.Converters"
        Title="Products"
        Width="1200"
        Height="800"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Search / status -->
            <RowDefinition Height="Auto"/>

            <!-- Product list -->
            <RowDefinition Height="*"/>

            <!-- Product editor -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <StackPanel>
                <TextBlock Text="Products"
                           Style="{StaticResource PageTitleStyle}"/>

                <TextBlock Text="Manage products, prices and availability"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Content="+  ADD PRODUCT"
                    Command="{Binding AddProductCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="145"
                    Height="42"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
        </Grid>


        <!-- ========================================================= -->
        <!-- SEARCH + STATUS                                            -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Width="320"
                     Height="40"
                     HorizontalAlignment="Left"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchTextBoxStyle}"
                     ToolTip="Search products"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextWrapping="Wrap"
                       Margin="20,0,0,0"/>
        </Grid>


        <!-- ========================================================= -->
        <!-- PRODUCT LIST                                               -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Table header -->
                    <RowDefinition Height="52"/>

                    <!-- Products -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TABLE HEADER                                       -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="#FAFBFC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="18,0">

                        <Grid.ColumnDefinitions>
                            <!-- Product -->
                            <ColumnDefinition Width="*"/>

                            <!-- Category -->
                            <ColumnDefinition Width="150"/>

                            <!-- Price -->
                            <ColumnDefinition Width="120"/>

                            <!-- Status -->
                            <ColumnDefinition Width="140"/>

                            <!-- Actions -->
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="PRODUCT"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="CATEGORY"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="PRICE"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="STATUS"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="ACTIONS"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- PRODUCT ROWS                                       -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Products}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="18,14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <!-- Product -->
                                            <ColumnDefinition Width="*"/>

                                            <!-- Category -->
                                            <ColumnDefinition Width="150"/>

                                            <!-- Price -->
                                            <ColumnDefinition Width="120"/>

                                            <!-- Status -->
                                            <ColumnDefinition Width="140"/>

                                            <!-- Actions -->
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- ================================= -->
                                        <!-- PRODUCT                           -->
                                        <!-- ================================= -->

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBlock Text="{Binding Id,
                                                       StringFormat='ID: {0}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0"/>

                                        </StackPanel>


                                        <!-- ================================= -->
                                        <!-- CATEGORY                          -->
                                        <!-- ================================= -->

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Category}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>


                                        <!-- ================================= -->
                                        <!-- PRICE                             -->
                                        <!-- ================================= -->

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Price,
                                                           StringFormat='{}{0:₹#,##0.00}'}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>


                                        <!-- ================================= -->
                                        <!-- STATUS                            -->
                                        <!-- ================================= -->

                                        <Border Grid.Column="3"
                                                Background="#E9F9F0"
                                                CornerRadius="14"
                                                Padding="12,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding IsAvailable,
                                                       Converter={StaticResource BooleanToAvailabilityConverter}}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>

                                        </Border>


                                        <!-- ================================= -->
                                        <!-- ACTIONS                           -->
                                        <!-- ================================= -->

                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Button Content="EDIT"
                                                    Command="{Binding DataContext.EditProductCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Width="76"
                                                    Height="40"
                                                    Margin="0,0,12,0"/>

                                            <Button Content="DELETE"
                                                    Command="{Binding DataContext.DeleteProductCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Width="82"
                                                    Height="40"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- PRODUCT EDITOR                                            -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,20,0,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- EDITOR TITLE                                      -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Product Editor"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Add a new product or update an existing product"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- EDITOR CONTENT                                    -->
                <!-- ================================================= -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="220"/>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="220"/>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="270"/>

                    </Grid.ColumnDefinitions>


                    <!-- ============================================= -->
                    <!-- PRODUCT NAME                                  -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="PRODUCT NAME"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="40"
                                 Text="{Binding ProductName,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- CATEGORY                                      -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="1"
                                Margin="0,0,20,0">

                        <TextBlock Text="CATEGORY"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="40"
                                 Text="{Binding Category,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- PRICE                                         -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">

                        <TextBlock Text="PRICE"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="40"
                                 Text="{Binding Price,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- EMOJI                                         -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="3"
                                Margin="0,0,20,0">

                        <TextBlock Text="ICON / EMOJI"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="40"
                                 Text="{Binding Emoji,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- AVAILABILITY                                   -->
                    <!-- ============================================= -->

                    <CheckBox Grid.Column="4"
                              Content="Product Available"
                              IsChecked="{Binding IsAvailable}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,20,11"
                              FontSize="13"
                              Foreground="{StaticResource TextPrimaryBrush}"/>


                    <!-- ============================================= -->
                    <!-- ACTION BUTTONS                                 -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">

                        <Button Content="CANCEL"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="95"
                                Height="40"
                                Margin="0,0,12,0"/>

                        <Button Content="SAVE PRODUCT"
                                Command="{Binding SaveProductCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"
                                Height="40"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>