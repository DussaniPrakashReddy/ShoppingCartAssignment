<UserControl x:Class="ShoppingCart.WPF.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShoppingCart.WPF.Controls"
             xmlns:views="clr-namespace:ShoppingCart.WPF.Views">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Products"
                           Style="{StaticResource SectionTitleStyle}"/>

                <Border Background="#EAF2FF"
                        CornerRadius="10"
                        Padding="8,3"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding Products.Count,
                                              StringFormat='{}{0} items'}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                </Border>

            </StackPanel>

            <TextBlock Text="Select a product to add it to the cart"
                       Style="{StaticResource SecondaryTextStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

        </Grid>


        <!-- ========================================================= -->
        <!-- PRODUCT LIST                                               -->
        <!-- ========================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding Products}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <controls:FruitCart
                            Fruit="{Binding}"
                            FruitName="{Binding Name}"
                            Price="{Binding Price}"
                            AddCommand="{Binding AddToCartCommand,
                                RelativeSource={
                                    RelativeSource AncestorType={x:Type views:ProductsView}
                                }}"/>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>