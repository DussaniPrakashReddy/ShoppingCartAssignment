<UserControl x:Class="ShoppingCart.WPF.Controls.FruitCart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="205"
             Width="205"
             Height="190"
             Background="Transparent">

    <Border>

        <Border.Style>

            <Style TargetType="{x:Type Border}"
                   BasedOn="{StaticResource ProductCardStyle}">

                <Setter Property="Background"
                        Value="{StaticResource SurfaceBrush}" />

                <Setter Property="BorderBrush"
                        Value="{StaticResource BorderBrush}" />

                <Setter Property="BorderThickness"
                        Value="1" />

                <Setter Property="CornerRadius"
                        Value="12" />

                <Setter Property="Padding"
                        Value="18" />

                <Setter Property="Cursor"
                        Value="Hand" />

                <Style.Triggers>

                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter Property="BorderBrush"
                                Value="{StaticResource PrimaryBrush}" />

                        <Setter Property="Background"
                                Value="#FBFDFF" />

                    </Trigger>

                </Style.Triggers>

            </Style>

        </Border.Style>


        <Grid>

            <Grid.RowDefinitions>

                <!-- Product information -->
                <RowDefinition Height="*" />

                <!-- Price -->
                <RowDefinition Height="35" />

                <!-- Add button -->
                <RowDefinition Height="42" />

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- PRODUCT INFORMATION                               -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding FruitName,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Text="Fresh quality produce"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />

            </StackPanel>


            <!-- ================================================= -->
            <!-- PRICE                                             -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="1"
                       Text="{Binding Price,
                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                      StringFormat='{}{0:₹#,##0.00}'}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center" />


            <!-- ================================================= -->
            <!-- ADD TO CART                                       -->
            <!-- ================================================= -->

            <Button Grid.Row="2"
                    Content="+  ADD TO CART"
                    Command="{Binding AddCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Fruit,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />

        </Grid>

    </Border>

</UserControl>